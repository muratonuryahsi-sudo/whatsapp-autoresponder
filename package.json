{
  "name": "whatsapp-autoresponder",
  "version": "1.0.0",
  "description": "WhatsApp AI Auto-Responder using whatsapp-web.js and Google Gemini",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "setup": "node setup.js",
    "dev": "node --watch-path=index.js --watch-path=gemini.js --watch-path=blacklist.js --watch-path=calendar.js --watch-path=.env index.js",
    "watch": "node --watch-path=index.js --watch-path=gemini.js --watch-path=blacklist.js --watch-path=calendar.js --watch-path=.env index.js",
    "postinstall": "node patch-wwebjs.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "gemini",
    "ai",
    "autoresponder"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.4.7",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  }
}
